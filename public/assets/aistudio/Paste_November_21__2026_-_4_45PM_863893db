<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Utsav AI — Plan Your Perfect Event with AI</title>

  <!-- Google Fonts: Playfair Display (Headings) & Inter (Body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />

  <style>
    /* ==========================================================================
       DESIGN SYSTEM VARIABLES
       ========================================================================== */
    :root {
      /* Brand Palette */
      --marigold: #E8A317;
      --marigold-dark: #CC8B0D;
      --marigold-soft: rgba(232, 163, 23, 0.14);
      --maroon: #7A1F3D;
      --maroon-dark: #5E152D;
      --blush: #F8E1E7;
      --blush-soft: rgba(248, 225, 231, 0.55);
      --ivory: #FFFBF5;
      --white: #FFFFFF;
      --text: #2B2024;
      --text-muted: #6C5B61;
      --border-subtle: rgba(122, 31, 61, 0.12);

      /* Typography */
      --font-heading: 'Playfair Display', Georgia, serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;

      /* Elevation & Shape */
      --radius-card: 16px;
      --radius-pill: 999px;
      --shadow-soft: 0 10px 30px rgba(43, 32, 36, 0.06);
      --shadow-hover: 0 18px 40px rgba(122, 31, 61, 0.11);
      --transition: all 0.28s cubic-bezier(0.22, 1, 0.36, 1);

      /* Layout */
      --container-max: 1180px;
      --nav-height: 76px;
      --sidebar-width: 260px;
    }

    /* ==========================================================================
       RESET & BASE STYLES
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--ivory);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, .font-serif {
      font-family: var(--font-heading);
      color: var(--text);
      line-height: 1.2;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      background: none;
    }

    ul {
      list-style: none;
    }

    .container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 24px;
    }

    .hidden {
      display: none !important;
    }

    /* Reusable Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 13px 26px;
      border-radius: var(--radius-pill);
      font-weight: 600;
      font-size: 0.95rem;
      transition: var(--transition);
      white-space: nowrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--marigold) 0%, #F2B538 100%);
      color: var(--text);
      box-shadow: 0 8px 22px rgba(232, 163, 23, 0.28);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, var(--marigold-dark) 0%, var(--marigold) 100%);
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(232, 163, 23, 0.36);
    }

    .btn-maroon {
      background-color: var(--maroon);
      color: var(--white);
      box-shadow: 0 8px 22px rgba(122, 31, 61, 0.22);
    }

    .btn-maroon:hover {
      background-color: var(--maroon-dark);
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(122, 31, 61, 0.3);
    }

    .btn-outline {
      background-color: var(--white);
      color: var(--maroon);
      border: 1.5px solid rgba(122, 31, 61, 0.24);
    }

    .btn-outline:hover {
      border-color: var(--maroon);
      background-color: var(--blush-soft);
      transform: translateY(-2px);
    }

    /* Section Header Helpers */
    .section {
      padding: 88px 0;
    }

    .section-header {
      text-align: center;
      max-width: 660px;
      margin: 0 auto 54px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: var(--radius-pill);
      background-color: var(--blush);
      color: var(--maroon);
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 14px;
    }

    .section-title {
      font-size: clamp(1.9rem, 3.6vw, 2.7rem);
      font-weight: 700;
      margin-bottom: 14px;
    }

    .section-subtitle {
      color: var(--text-muted);
      font-size: 1.04rem;
    }

    /* Scroll Fade-in Animation */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================================================
       VIEW 1: LANDING PAGE
       ========================================================================== */

    /* Sticky Navbar */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      height: var(--nav-height);
      background: rgba(255, 251, 245, 0.88);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-subtle);
      transition: var(--transition);
    }

    .navbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 100%;
    }

    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-heading);
      font-size: 1.45rem;
      font-weight: 700;
      color: var(--maroon);
    }

    .brand-mark {
      width: 36px;
      height: 36px;
      border-radius: 11px;
      background: linear-gradient(135deg, var(--maroon) 0%, #9E2B51 100%);
      color: var(--marigold);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(122, 31, 61, 0.24);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .nav-link {
      font-size: 0.94rem;
      font-weight: 500;
      color: var(--text-muted);
      transition: color 0.2s ease;
    }

    .nav-link:hover {
      color: var(--maroon);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .nav-cta {
      padding: 10px 22px;
      font-size: 0.9rem;
    }

    .hamburger-btn {
      display: none;
      width: 42px;
      height: 42px;
      border-radius: 10px;
      align-items: center;
      justify-content: center;
      color: var(--maroon);
      background-color: var(--blush-soft);
    }

    /* Mobile Drawer Menu */
    .mobile-menu {
      display: none;
      position: fixed;
      top: var(--nav-height);
      left: 0;
      right: 0;
      background: var(--ivory);
      border-bottom: 1px solid var(--border-subtle);
      padding: 20px 24px 28px;
      box-shadow: 0 18px 36px rgba(43, 32, 36, 0.1);
      z-index: 99;
      flex-direction: column;
      gap: 16px;
    }

    .mobile-menu.open {
      display: flex;
    }

    .mobile-menu .nav-link {
      padding: 8px 0;
      font-size: 1.05rem;
      border-bottom: 1px dashed rgba(122, 31, 61, 0.1);
    }

    /* Full-Viewport Hero */
    .hero {
      position: relative;
      min-height: calc(100vh - var(--nav-height));
      display: flex;
      align-items: center;
      padding: 56px 0 72px;
      overflow: hidden;
      background:
        radial-gradient(circle at 12% 18%, rgba(248, 225, 231, 0.72) 0%, transparent 45%),
        radial-gradient(circle at 88% 22%, rgba(232, 163, 23, 0.15) 0%, transparent 42%),
        radial-gradient(circle at 75% 88%, rgba(248, 225, 231, 0.5) 0%, transparent 40%),
        var(--ivory);
    }

    /* Subtle Floral & Confetti Motif Layer */
    .hero-motif {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 0;
    }

    .mandala-top-right {
      position: absolute;
      top: -110px;
      right: -110px;
      width: 460px;
      height: 460px;
      opacity: 0.12;
      color: var(--maroon);
      animation: slowSpin 75s linear infinite;
    }

    .mandala-bottom-left {
      position: absolute;
      bottom: -140px;
      left: -120px;
      width: 380px;
      height: 380px;
      opacity: 0.14;
      color: var(--marigold);
      animation: slowSpin 90s linear infinite reverse;
    }

    @keyframes slowSpin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .confetti-dot {
      position: absolute;
      border-radius: 50%;
      opacity: 0.45;
    }

    .confetti-petal {
      position: absolute;
      width: 14px;
      height: 8px;
      border-radius: 10px 2px 10px 2px;
      opacity: 0.35;
    }

    .hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.12fr 0.88fr;
      gap: 48px;
      align-items: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 15px;
      border-radius: var(--radius-pill);
      background-color: var(--white);
      border: 1px solid rgba(232, 163, 23, 0.35);
      box-shadow: 0 4px 14px rgba(43, 32, 36, 0.04);
      font-size: 0.84rem;
      font-weight: 600;
      color: var(--maroon);
      margin-bottom: 22px;
    }

    .hero-badge-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--marigold);
      box-shadow: 0 0 0 4px rgba(232, 163, 23, 0.22);
    }

    .hero-title {
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 700;
      letter-spacing: -0.015em;
      margin-bottom: 20px;
      color: var(--text);
    }

    .hero-title span {
      color: var(--maroon);
      position: relative;
      display: inline-block;
    }

    .hero-title span::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 4px;
      width: 100%;
      height: 10px;
      background-color: rgba(232, 163, 23, 0.28);
      z-index: -1;
      border-radius: 4px;
    }

    .hero-subtext {
      font-size: clamp(1.05rem, 1.5vw, 1.2rem);
      color: var(--text-muted);
      max-width: 540px;
      margin-bottom: 32px;
    }

    .hero-ctas {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      margin-bottom: 34px;
    }

    .hero-trust {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      font-size: 0.86rem;
      color: var(--text-muted);
    }

    .hero-trust-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .hero-trust-item svg {
      color: var(--marigold-dark);
    }

    /* Hero Right Visual Preview Card */
    .hero-card {
      background: var(--white);
      border-radius: 22px;
      padding: 26px;
      box-shadow: 0 24px 60px rgba(122, 31, 61, 0.12);
      border: 1px solid rgba(122, 31, 61, 0.08);
      position: relative;
    }

    .hero-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border-subtle);
      margin-bottom: 18px;
    }

    .shubh-avatar {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .shubh-orb {
      width: 42px;
      height: 42px;
      border-radius: 13px;
      background: linear-gradient(135deg, var(--maroon), #A82E57);
      color: var(--marigold);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
    }

    .shubh-meta h4 {
      font-size: 1rem;
      font-family: var(--font-body);
      font-weight: 700;
    }

    .shubh-meta span {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .pill-live {
      padding: 5px 12px;
      border-radius: var(--radius-pill);
      background: var(--blush);
      color: var(--maroon);
      font-size: 0.75rem;
      font-weight: 700;
    }

    .hero-prompt-bubble {
      background: var(--ivory);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 14px 16px;
      font-size: 0.88rem;
      color: var(--text);
      margin-bottom: 16px;
    }

    .hero-prompt-label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--maroon);
      margin-bottom: 4px;
      display: block;
    }

    .hero-plan-metrics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 16px;
    }

    .metric-mini {
      background: var(--blush-soft);
      border-radius: 12px;
      padding: 12px 10px;
      text-align: center;
    }

    .metric-mini strong {
      display: block;
      font-size: 1.05rem;
      color: var(--maroon);
      font-family: var(--font-heading);
    }

    .metric-mini span {
      font-size: 0.74rem;
      color: var(--text-muted);
    }

    .hero-task-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .hero-task-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 13px;
      border-radius: 12px;
      background: var(--ivory);
      font-size: 0.85rem;
    }

    .hero-task-left {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 500;
    }

    .task-check {
      width: 20px;
      height: 20px;
      border-radius: 6px;
      background: var(--marigold-soft);
      color: var(--marigold-dark);
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .task-tag {
      font-size: 0.73rem;
      font-weight: 600;
      color: var(--maroon);
      background: var(--blush);
      padding: 3px 9px;
      border-radius: var(--radius-pill);
    }

    /* Feature Cards (6 Cards) */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .feature-card {
      background: var(--white);
      border-radius: var(--radius-card);
      padding: 30px 26px;
      box-shadow: var(--shadow-soft);
      border: 1px solid rgba(122, 31, 61, 0.06);
      transition: var(--transition);
    }

    .feature-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-hover);
      border-color: rgba(232, 163, 23, 0.45);
    }

    .feature-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: var(--blush);
      color: var(--maroon);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      transition: var(--transition);
    }

    .feature-card:hover .feature-icon {
      background: var(--marigold);
      color: var(--text);
    }

    .feature-card h3 {
      font-size: 1.3rem;
      margin-bottom: 10px;
    }

    .feature-card p {
      color: var(--text-muted);
      font-size: 0.94rem;
    }

    /* How It Works 4-Step Strip */
    .how-strip {
      background: linear-gradient(180deg, rgba(248, 225, 231, 0.36) 0%, rgba(255, 251, 245, 0.8) 100%);
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
    }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
      position: relative;
    }

    .step-card {
      background: var(--white);
      border-radius: var(--radius-card);
      padding: 26px 22px;
      box-shadow: var(--shadow-soft);
      position: relative;
      transition: var(--transition);
      border: 1px solid rgba(122, 31, 61, 0.06);
    }

    .step-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
    }

    .step-number {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--maroon);
      color: var(--white);
      font-weight: 700;
      font-size: 0.92rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      box-shadow: 0 6px 14px rgba(122, 31, 61, 0.22);
    }

    .step-card h3 {
      font-size: 1.15rem;
      margin-bottom: 8px;
    }

    .step-card p {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    /* Event-Type Chips Section */
    .event-types-box {
      background: var(--white);
      border-radius: 22px;
      padding: 46px 36px;
      box-shadow: var(--shadow-soft);
      text-align: center;
      border: 1px solid var(--border-subtle);
    }

    .chips-wrap {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
      margin-top: 28px;
      margin-bottom: 24px;
    }

    .event-chip {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 13px 22px;
      border-radius: var(--radius-pill);
      background: var(--ivory);
      border: 1.5px solid rgba(122, 31, 61, 0.16);
      color: var(--text);
      font-weight: 600;
      font-size: 0.96rem;
      transition: var(--transition);
    }

    .event-chip:hover,
    .event-chip.active {
      background: var(--maroon);
      color: var(--white);
      border-color: var(--maroon);
      transform: translateY(-3px);
      box-shadow: 0 10px 22px rgba(122, 31, 61, 0.2);
    }

    .chip-caption {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    /* 3-Tier Pricing */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 26px;
      align-items: stretch;
    }

    .pricing-card {
      background: var(--white);
      border-radius: var(--radius-card);
      padding: 34px 28px;
      box-shadow: var(--shadow-soft);
      border: 1px solid rgba(122, 31, 61, 0.08);
      display: flex;
      flex-direction: column;
      transition: var(--transition);
      position: relative;
    }

    .pricing-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-hover);
    }

    .pricing-card.featured {
      border: 2px solid var(--marigold);
      box-shadow: 0 20px 44px rgba(232, 163, 23, 0.16);
    }

    .pricing-badge {
      position: absolute;
      top: -13px;
      right: 24px;
      background: var(--marigold);
      color: var(--text);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 5px 14px;
      border-radius: var(--radius-pill);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pricing-tier {
      font-size: 1.35rem;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .pricing-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 22px;
    }

    .pricing-price {
      font-family: var(--font-heading);
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--maroon);
      margin-bottom: 22px;
    }

    .pricing-price span {
      font-family: var(--font-body);
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-muted);
    }

    .pricing-features {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 30px;
      flex: 1;
    }

    .pricing-features li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 0.92rem;
      color: var(--text);
    }

    .pricing-features svg {
      flex-shrink: 0;
      margin-top: 3px;
      color: var(--marigold-dark);
    }

    /* Testimonials (3 Cards) */
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .testimonial-card {
      background: var(--white);
      border-radius: var(--radius-card);
      padding: 30px 26px;
      box-shadow: var(--shadow-soft);
      border: 1px solid rgba(122, 31, 61, 0.06);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: var(--transition);
    }

    .testimonial-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
    }

    .stars {
      color: var(--marigold);
      font-size: 0.95rem;
      letter-spacing: 2px;
      margin-bottom: 14px;
    }

    .testimonial-quote {
      font-size: 0.96rem;
      color: var(--text);
      margin-bottom: 24px;
      line-height: 1.65;
    }

    .testimonial-author {
      display: flex;
      align-items: center;
      gap: 12px;
      padding-top: 16px;
      border-top: 1px solid var(--border-subtle);
    }

    .author-avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--blush);
      color: var(--maroon);
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
    }

    .author-info strong {
      display: block;
      font-size: 0.92rem;
    }

    .author-info span {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    /* CTA Banner */
    .cta-banner-section {
      padding: 20px 0 88px;
    }

    .cta-banner {
      background: linear-gradient(135deg, var(--maroon) 0%, #5B142C 100%);
      border-radius: 24px;
      padding: 58px 42px;
      text-align: center;
      color: var(--white);
      position: relative;
      overflow: hidden;
      box-shadow: 0 24px 50px rgba(122, 31, 61, 0.25);
    }

    .cta-banner::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 20% 20%, rgba(232, 163, 23, 0.22), transparent 45%),
                  radial-gradient(circle at 80% 80%, rgba(248, 225, 231, 0.16), transparent 45%);
      pointer-events: none;
    }

    .cta-banner-content {
      position: relative;
      z-index: 1;
      max-width: 640px;
      margin: 0 auto;
    }

    .cta-banner h2 {
      color: var(--white);
      font-size: clamp(1.9rem, 3.6vw, 2.7rem);
      margin-bottom: 14px;
    }

    .cta-banner p {
      color: rgba(255, 251, 245, 0.86);
      font-size: 1.05rem;
      margin-bottom: 28px;
    }

    /* 4-Column Footer */
    .footer {
      background: var(--white);
      border-top: 1px solid var(--border-subtle);
      padding: 64px 0 32px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 48px;
    }

    .footer-brand p {
      color: var(--text-muted);
      font-size: 0.92rem;
      margin-top: 14px;
      max-width: 280px;
    }

    .footer-col h4 {
      font-family: var(--font-body);
      font-size: 0.88rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--maroon);
      margin-bottom: 16px;
    }

    .footer-col ul {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .footer-col a {
      font-size: 0.92rem;
      color: var(--text-muted);
      transition: color 0.2s ease;
    }

    .footer-col a:hover {
      color: var(--maroon);
    }

    .footer-bottom {
      padding-top: 24px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* ==========================================================================
       VIEW 2: APP SHELL
       ========================================================================== */
    .app-shell {
      display: flex;
      min-height: 100vh;
      background-color: var(--ivory);
    }

    /* Left Sidebar (Desktop) */
    .app-sidebar {
      width: var(--sidebar-width);
      background-color: var(--white);
      border-right: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 24px 16px;
      position: sticky;
      top: 0;
      height: 100vh;
      flex-shrink: 0;
    }

    .sidebar-header {
      padding: 0 8px 20px;
      border-bottom: 1px solid var(--border-subtle);
      margin-bottom: 20px;
    }

    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .sidebar-tab {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: 12px;
      font-size: 0.94rem;
      font-weight: 500;
      color: var(--text-muted);
      transition: var(--transition);
      text-align: left;
      width: 100%;
    }

    .sidebar-tab:hover {
      background-color: var(--ivory);
      color: var(--maroon);
    }

    .sidebar-tab.active {
      background-color: var(--blush);
      color: var(--maroon);
      font-weight: 700;
      box-shadow: inset 3px 0 0 var(--marigold);
    }

    .sidebar-footer {
      padding-top: 16px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .back-home-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      border-radius: 10px;
      font-size: 0.86rem;
      font-weight: 600;
      color: var(--text-muted);
      transition: var(--transition);
    }

    .back-home-btn:hover {
      background-color: var(--blush-soft);
      color: var(--maroon);
    }

    /* Main App Content Area */
    .app-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    /* Top Bar */
    .app-topbar {
      height: 72px;
      background-color: rgba(255, 251, 245, 0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .topbar-event {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .topbar-event-title {
      font-family: var(--font-heading);
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .topbar-event-badge {
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      background: var(--blush);
      color: var(--maroon);
      font-size: 0.74rem;
      font-weight: 700;
      flex-shrink: 0;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      position: relative;
    }

    .countdown-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 15px;
      border-radius: var(--radius-pill);
      background: var(--marigold-soft);
      border: 1px solid rgba(232, 163, 23, 0.4);
      color: var(--maroon);
      font-weight: 700;
      font-size: 0.85rem;
      white-space: nowrap;
    }

    .bell-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--white);
      border: 1px solid var(--border-subtle);
      color: var(--maroon);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      transition: var(--transition);
    }

    .bell-btn:hover {
      background: var(--blush);
    }

    .bell-dot {
      position: absolute;
      top: 8px;
      right: 9px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--marigold);
      border: 1.5px solid var(--white);
    }

    .reminder-popover {
      position: absolute;
      top: 52px;
      right: 0;
      width: 280px;
      background: var(--white);
      border-radius: 16px;
      padding: 16px;
      box-shadow: var(--shadow-hover);
      border: 1px solid var(--border-subtle);
      z-index: 60;
    }

    .reminder-popover h4 {
      font-family: var(--font-body);
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--maroon);
      margin-bottom: 10px;
    }

    .reminder-item {
      font-size: 0.82rem;
      color: var(--text-muted);
      padding: 8px 0;
      border-top: 1px dashed var(--border-subtle);
    }

    /* Tab Content Panels */
    .app-content {
      padding: 32px;
      flex: 1;
    }

    .tab-panel {
      display: none;
      animation: fadeTab 0.24s ease;
    }

    .tab-panel.active {
      display: block;
    }

    @keyframes fadeTab {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .tab-header {
      margin-bottom: 26px;
    }

    .tab-header h1 {
      font-size: 2rem;
      margin-bottom: 6px;
    }

    .tab-header p {
      color: var(--text-muted);
      font-size: 0.96rem;
    }

    /* Placeholder Grid & Dashed-Border Boxes */
    .placeholder-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 20px;
    }

    .placeholder-box {
      background: var(--white);
      border: 2px dashed rgba(122, 31, 61, 0.25);
      border-radius: var(--radius-card);
      padding: 28px 24px;
      min-height: 180px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: var(--transition);
      grid-column: span 4;
    }

    .placeholder-box:hover {
      border-color: var(--marigold);
      box-shadow: var(--shadow-soft);
    }

    .placeholder-box.span-6 {
      grid-column: span 6;
    }

    .placeholder-box.span-8 {
      grid-column: span 8;
    }

    .placeholder-box.span-12 {
      grid-column: span 12;
      min-height: 220px;
    }

    .placeholder-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      align-self: flex-start;
      padding: 4px 11px;
      border-radius: var(--radius-pill);
      background: var(--blush-soft);
      color: var(--maroon);
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 14px;
    }

    .placeholder-box h3 {
      font-size: 1.32rem;
      margin-bottom: 8px;
      color: var(--text);
    }

    .placeholder-box p {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .placeholder-meta {
      margin-top: 20px;
      padding-top: 12px;
      border-top: 1px dashed rgba(122, 31, 61, 0.14);
      font-size: 0.8rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* ==========================================================================
       RESPONSIVE BREAKPOINTS
       ========================================================================== */
    @media (max-width: 1024px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 36px;
      }

      .features-grid,
      .pricing-grid,
      .testimonials-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .steps-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .footer-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .placeholder-box,
      .placeholder-box.span-6,
      .placeholder-box.span-8 {
        grid-column: span 6;
      }
    }

    @media (max-width: 768px) {
      .nav-links,
      .nav-actions .nav-cta {
        display: none;
      }

      .hamburger-btn {
        display: inline-flex;
      }

      .section {
        padding: 64px 0;
      }

      .features-grid,
      .steps-grid,
      .pricing-grid,
      .testimonials-grid,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .hero-plan-metrics {
        grid-template-columns: repeat(3, 1fr);
      }

      .cta-banner {
        padding: 42px 24px;
      }

      /* App Shell: Collapse Left Sidebar to Fixed Bottom Tab Bar */
      .app-shell {
        flex-direction: column;
        padding-bottom: 72px;
      }

      .app-sidebar {
        position: fixed;
        bottom: 0;
        top: auto;
        left: 0;
        right: 0;
        width: 100%;
        height: 68px;
        flex-direction: row;
        padding: 6px 8px;
        border-right: none;
        border-top: 1px solid var(--border-subtle);
        box-shadow: 0 -8px 24px rgba(43, 32, 36, 0.08);
        z-index: 80;
      }

      .sidebar-header,
      .sidebar-footer {
        display: none;
      }

      .sidebar-nav {
        flex-direction: row;
        width: 100%;
        justify-content: space-around;
        gap: 2px;
      }

      .sidebar-tab {
        flex-direction: column;
        justify-content: center;
        gap: 3px;
        padding: 6px 4px;
        font-size: 0.68rem;
        border-radius: 10px;
      }

      .sidebar-tab.active {
        box-shadow: none;
        background: var(--blush);
      }

      .app-topbar {
        padding: 0 16px;
        height: 64px;
      }

      .topbar-event-badge {
        display: none;
      }

      .topbar-event-title {
        font-size: 1.08rem;
      }

      .countdown-pill {
        padding: 5px 10px;
        font-size: 0.78rem;
      }

      .app-content {
        padding: 20px 16px;
      }

      .placeholder-box,
      .placeholder-box.span-6,
      .placeholder-box.span-8,
      .placeholder-box.span-12 {
        grid-column: span 12;
        min-height: 150px;
      }
    }
  </style>
</head>
