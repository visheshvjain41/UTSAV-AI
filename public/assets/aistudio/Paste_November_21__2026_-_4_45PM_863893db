  <!-- ========================================================================
       VANILLA JAVASCRIPT: View Switching, Tabs, Scroll Animations & Interactions
       ======================================================================== -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // ----------------------------------------------------------------------
      // DOM References
      // ----------------------------------------------------------------------
      const landingView = document.getElementById('landing-view');
      const appView = document.getElementById('app-view');
      const startButtons = document.querySelectorAll('.js-start-planning');
      const backHomeButtons = document.querySelectorAll('.js-back-home');

      const hamburgerBtn = document.getElementById('hamburger-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileLinks = document.querySelectorAll('.js-mobile-link');

      const eventChips = document.querySelectorAll('.event-chip');
      const chipCaption = document.getElementById('chip-caption');
      const appEventName = document.getElementById('app-event-name');
      const appEventTypeBadge = document.getElementById('app-event-type-badge');

      const sidebarTabs = document.querySelectorAll('.sidebar-tab');
      const tabPanels = document.querySelectorAll('.tab-panel');

      const bellBtn = document.getElementById('bell-btn');
      const reminderPopover = document.getElementById('reminder-popover');

      // Event label mapping when a chip is selected on landing page
      const eventDescriptions = {
        'Wedding': {
          title: "Meera & Kabir's Wedding",
          caption: 'Multi-day ceremonies, vendor coordination, and full family RSVP tracking ready.'
        },
        'Engagement': {
          title: "Aarav & Tara's Engagement",
          caption: 'Ring ceremony timeline, floral stage shortlist, and intimate guest list ready.'
        },
        'Birthday': {
          title: "Dadi's 75th Birthday Bash",
          caption: 'Theme decor moodboard, catering headcount, and music playlist checklist ready.'
        },
        'Anniversary': {
          title: "25th Anniversary Soirée",
          caption: 'Dinner seating layout, family tribute timeline, and budget guardrails ready.'
        },
        'Corporate Offsite': {
          title: "Annual Team Offsite 2026",
          caption: 'Resort room blocks, keynote run-of-show, and travel logistics tracker ready.'
        },
        'Baby Shower': {
          title: "Godh Bharai & Baby Shower",
          caption: 'Traditional ritual checklist, pastel floral decor budget, and guest invites ready.'
        }
      };

      // ----------------------------------------------------------------------
      // 1. View Switcher (View 1: Landing <-> View 2: App Shell)
      // ----------------------------------------------------------------------
      function showAppView() {
        landingView.classList.add('hidden');
        appView.classList.remove('hidden');
        mobileMenu.classList.remove('open');
        hamburgerBtn.setAttribute('aria-expanded', 'false');
        window.scrollTo({ top: 0, behavior: 'instant' });
      }

      function showLandingView() {
        appView.classList.add('hidden');
        landingView.classList.remove('hidden');
        reminderPopover.classList.add('hidden');
        window.scrollTo({ top: 0, behavior: 'instant' });
      }

      startButtons.forEach((btn) => {
        btn.addEventListener('click', showAppView);
      });

      backHomeButtons.forEach((btn) => {
        btn.addEventListener('click', showLandingView);
      });

      // ----------------------------------------------------------------------
      // 2. Mobile Hamburger Menu Toggle
      // ----------------------------------------------------------------------
      hamburgerBtn.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.toggle('open');
        hamburgerBtn.setAttribute('aria-expanded', String(isOpen));
      });

      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.remove('open');
          hamburgerBtn.setAttribute('aria-expanded', 'false');
        });
      });

      // ----------------------------------------------------------------------
      // 3. Interactive Event-Type Chips
      // ----------------------------------------------------------------------
      eventChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          eventChips.forEach((c) => c.classList.remove('active'));
          chip.classList.add('active');

          const selectedType = chip.dataset.event;
          const details = eventDescriptions[selectedType];

          if (details) {
            chipCaption.innerHTML = `Selected: <strong>${selectedType}</strong> — ${details.caption}`;
            appEventName.textContent = details.title;
            appEventTypeBadge.textContent = selectedType;
          }
        });
      });

      // ----------------------------------------------------------------------
      // 4. App Shell Tab Switching (Only One Tab Visible at a Time)
      // ----------------------------------------------------------------------
      sidebarTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const targetId = `tab-${tab.dataset.tab}`;

          // Update active tab state
          sidebarTabs.forEach((t) => {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');

          // Show only the matching panel
          tabPanels.forEach((panel) => {
            panel.classList.toggle('active', panel.id === targetId);
          });

          // Close reminders popover if open
          reminderPopover.classList.add('hidden');
        });
      });

      // ----------------------------------------------------------------------
      // 5. Top Bar Reminders Bell Popover
      // ----------------------------------------------------------------------
      bellBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = reminderPopover.classList.toggle('hidden');
        bellBtn.setAttribute('aria-expanded', String(!isHidden));
      });

      document.addEventListener('click', (e) => {
        if (!reminderPopover.contains(e.target) && !bellBtn.contains(e.target)) {
          reminderPopover.classList.add('hidden');
          bellBtn.setAttribute('aria-expanded', 'false');
        }
      });

      // ----------------------------------------------------------------------
      // 6. Scroll Fade-In Animations via IntersectionObserver
      // ----------------------------------------------------------------------
      const revealElements = document.querySelectorAll('.reveal');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -30px 0px' }
        );

        revealElements.forEach((el) => observer.observe(el));
      } else {
        // Fallback for older browsers
        revealElements.forEach((el) => el.classList.add('is-visible'));
      }
    });
  </script>
